# Copy this file to .env and adjust for your environment.

# --- Database -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=library_admin
DB_PASSWORD=Library@2026
DB_NAME=library_management_system

# --- Auth -----------------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- App --------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
